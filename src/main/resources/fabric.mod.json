{
	"schemaVersion": 1,
	"id": "ender-endeavors",
	"version": "${version}",
	"name": "Ender Endeavors",
	"description": "A work-in-progress Fabric mod that aims to make Minecraft's End more challenging and rewarding with reworked mechanics, new challenges, and clearer progression.",
	"authors": [
		"AlexOptane",
		"Casado",
		"gonza333",
		"miguelbgo"
	],
	"contact": {
		"homepage": "https://github.com/alexoptane/ender-endeavors",
		"sources": "https://github.com/alexoptane/ender-endeavors"
	},
	"license": "CC0-1.0",
	"icon": "assets/ender-endeavors/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"com.optane.EnderEndeavors"
		],
		"client": [
			"com.optane.client.EnderEndeavorsClient"
		],
		"fabric-datagen": [
			"com.optane.client.datagen.EnderEndeavorsDataGenerator"
		]
	},
	"mixins": [
		"ender-endeavors.mixins.json",
		{
			"config": "ender-endeavors.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.20.1",
		"minecraft": "~26.3",
		"java": ">=25",
		"fabric-api": "*"
	}
}
