{
	"schemaVersion": 1,
	"id": "endermod",
	"version": "${version}",
	"name": "Endermod",
	"description": "A work-in-progress Fabric mod that aims to make Minecraft's End more challenging and rewarding with reworked mechanics, new challenges, and clearer progression.",
	"authors": [
		"AlexOptane",
		"Casado",
		"gonza333",
		"miguelbgo"
	],
	"contact": {
		"homepage": "https://github.com/alexoptane/endermod",
		"sources": "https://github.com/alexoptane/endermod"
	},
	"license": "CC0-1.0",
	"icon": "assets/endermod/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"com.example.TemplateMod"
		],
		"client": [
			"com.example.client.TemplateModClient"
		],
		"fabric-datagen": [
			"com.example.client.datagen.EndermodDataGenerator"
		]
	},
	"mixins": [
		"template-mod.mixins.json",
		{
			"config": "template-mod.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.20.1",
		"minecraft": "~26.3",
		"java": ">=25",
		"fabric-api": "*"
	}
}
